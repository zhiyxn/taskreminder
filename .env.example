# 事项提醒系统 - 配置文件

# 服务端口
PORT=3000

# 登录账号（首次启动会自动创建用户，之后请通过设置页面修改）
# 不设置 LOGIN_PASSWORD 时会随机生成初始密码，并在启动日志中打印一次
LOGIN_USERNAME=admin
# LOGIN_PASSWORD=

# ===== 安全相关 =====

# 通知凭据（bot token / SMTP 密码 / 飞书 app secret / bark 地址）的加密密钥。
# 可填 64 位十六进制字符串，或任意口令（内部用 scrypt 派生）。
# 留空则自动生成 data/.encryption-key —— 此时密钥与数据库同目录，
# 只能防住"仅数据库泄露"的情形，生产环境建议显式配置本项使密钥与数据分离。
# 生成方式: openssl rand -hex 32
# 修改或丢失该密钥会导致已保存的凭据无法解密。
# ENCRYPTION_KEY=

# 登录会话有效期（小时），默认 168（7 天）。持续使用会滑动续期，闲置则到期失效。
# SESSION_TTL_HOURS=168

# 反向代理层数。留空表示直接暴露，按 TCP 源地址限流。
# 部署在 Nginx/Traefik 后面时设为 1，否则所有请求会被算作同一个 IP。
# 注意：代理层必须自己覆写 X-Forwarded-For，否则客户端可伪造 IP 绕过限流。
# TRUST_PROXY=1

# 是否允许 Bark / SMTP 指向内网地址。默认 false，用于阻断 SSRF。
# 只有在自建 Bark 或内网 SMTP 且信任全部使用者时才开启。
# ALLOW_PRIVATE_NETWORK=true
